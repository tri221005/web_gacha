SESSION_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien
# 0.0.0.0 de may chu ao (Render / Railway / VPS) dua tiep tuc vao app.
# Giu 127.0.0.1 khi chay local tren may chu Minecraft.
HOST=127.0.0.1
PORT=8080
# "auto" danh dau cookie phien lam Secure chi khi request den bang HTTPS.
# Dung "true" de bat luon, "false" de khong dung. Gia tri cu "true" lam
# dang nhap hong khi web chay tren HTTP.
SESSION_HTTPS_ONLY=auto

PIKA_BASE_URL=https://hub.pikamc.vn
PIKA_API_KEY=
PIKA_SERVER_UUID=
PIKA_AUTHME_DB=/plugins/AuthMe/authme.db
PIKA_ECONOMY_DB=/plugins/ExcellentEconomy/data.db
ADMIN_USERS=
# Mat khau rieng cho trang /admin/login. Neu de trong, chi tai khoan
# Minecraft trong ADMIN_USERS moi dang nhap duoc vao console.
ADMIN_PASSWORD=
# Nhom LuckPerms tren server Minecraft duoc coi la "admin".
ADMIN_GROUP=admin
# Bao lau danh sach admin duoc dong bo lai (giay).
ADMIN_SYNC_SECONDS=30
GACHA_DRY_RUN=true

# SQL Server chua ledger gacha (bang gacha_*). Nap schema bang:
#   sqlcmd -S localhost -E -d jellyvale -i jellyvale_full.sql
SQL_SERVER=localhost
SQL_DATABASE=jellyvale

# Login SQL Server. De trong tren Windows (dung chung tai khoan Windows).
# tren Linux / Docker / may chu ao thi PHAI dat SQL_USER va SQL_PASSWORD,
# vi Windows integrated login khong ton tai tren may do.
SQL_USER=
SQL_PASSWORD=
# Chi can khi may chu SQL Server dung co khac ten driver.
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_PORT=
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
